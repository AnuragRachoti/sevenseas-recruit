# Choose ollama, openai, or anthropic. Leave blank for built-in rule-based processing.
AI_PROVIDER=ollama

# Ollama (local by default; no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Hosted provider options (only needed when selected above)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5